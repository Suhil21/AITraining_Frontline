    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Frontline (Windows)",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": ["classify" , "Not a support request — just wanted to say the docs for the camera are excellent.", "--method",  "llm"],
            "python": "${cwd}\\.venv\\Scripts\\python.exe"
        },
        {
            "name": "Debug: Frontline (Linux/Mac)",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": ["classify" , "Not a support request — just wanted to say the docs for the camera are excellent.", "--method",  "llm"],
            "python": "${cwd}/.venv/bin/python"
        },

        // Comparison Bakeoff (Change the path like above to match Windows)
        {
            "name": "Debug: Comparison Bakeoff (Linux/Mac)",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": ["bakeoff"],
            "python": "${cwd}/.venv/bin/python"
        }
    ]
}